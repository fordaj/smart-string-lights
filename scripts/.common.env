# scripts/.common.env — base environment for smart-string-lights.
#
# Sourced by scripts/env.sh before the platform-specific env
# (.<os>-<arch>.env, e.g. .windows-x86_64.env). Platform-independent
# variables live here; OS/arch specifics live there.
#
# The platform specific env files also set PROJECT_PLATFORM (e.g.
# "windows-x86_64"), the name of the platform of the current machine. It is
# used to resolve the bundled tools.

# ─── Repository ───────────────────────────────────────────────────────────
REPO_HOST="github.com"
REPO_OWNER="fordaj"
REPO_NAME="smart-string-lights"

# ─── Versioning ───────────────────────────────────────────────────────────
# The version is computed by scripts/version.sh (versioner; see
# .versioner.json). scripts/version.sh --write materialises
# .version/Version.hpp and .version/Version.txt for the C++ build.
VERSION_DIR=".version"

# ─── Embedded ────────────────────────────────────────────────────────────
PIO_DATA_DIR="data"
EMBEDDED_DIR="Embedded"
EMBEDDED_HELPERS_SH="${EMBEDDED_DIR}/helpers.sh"
CLEAN_SH="${EMBEDDED_DIR}/clean.sh"
BUILD_SH="${EMBEDDED_DIR}/build.sh"
RUN_SH="${EMBEDDED_DIR}/run.sh"
FLASH_SH="${EMBEDDED_DIR}/flash.sh"
DETECT_SH="${EMBEDDED_DIR}/detect.sh"
RUN_PIO_CMD_PS1="${EMBEDDED_DIR}/run_pio_cmd.ps1"

# ─── python virtualenv (created and kept in sync with `uv sync`) ─────────
VENV="./.venv"

# ─── ESP32-S3 / emulated release payloads (identical on every OS) ────────
# Unused until Embedded/release.sh is ported over; kept so the release
# script has its payload lists ready.
ESP32_S3_RELEASE_FILES=(
    ".pio/build/ESP32_S3/firmware.bin"
    ".pio/build/ESP32_S3/firmware.factory.bin"
    ".pio/build/ESP32_S3/firmware.elf"
    ".pio/build/ESP32_S3/bootloader.bin"
    ".pio/build/ESP32_S3/partitions.bin"
    "LICENSE"
)
ESP32_S3_EMULATED_RELEASE_FILES=(
    ".pio/build/ESP32_S3_EMULATED/firmware.bin"
    ".pio/build/ESP32_S3_EMULATED/firmware.factory.bin"
    ".pio/build/ESP32_S3_EMULATED/firmware.elf"
    ".pio/build/ESP32_S3_EMULATED/bootloader.bin"
    ".pio/build/ESP32_S3_EMULATED/partitions.bin"
    "LICENSE"
)

# ─── Pinned tools (see tools/README.md) ─────────────────────────────────
TOOLS_DIR="tools"

VERSIONER_REPO="fordaj/Versioner"
VERSIONER_TAG_PATTERN="v[0-9]*"
VERSIONER_CONFIG_FILE=".versioner.json"
VERSIONER_DIR="${TOOLS_DIR}/versioner"
VERSIONER_VERSION_DIR="${VERSIONER_DIR}/v0.0.3.0.17"

LOGAMUFFIN_REPO="fordaj/logamuffin"
LOGAMUFFIN_DIR="${TOOLS_DIR}/logamuffin"
LOGAMUFFIN_VERSION_DIR="${LOGAMUFFIN_DIR}/v0.1.3.0.35"

RUNNER_SPAWNER_TOOL_REPO="fordaj/runner-spawner"
RUNNER_SPAWNER_DIR="${TOOLS_DIR}/runner-spawner"
RUNNER_SPAWNER_VERSION_DIR="${RUNNER_SPAWNER_DIR}/v0.0.1.2.16"

BARNACLE_REPO="fordaj/barnacle"
BARNACLE_DIR="${TOOLS_DIR}/barnacle"
BARNACLE_VERSION_DIR="${BARNACLE_DIR}/v0.0.2.1.25"

FORMATTINGTON_REPO="fordaj/formattington"
FORMATTINGTON_LITE_DIR="${TOOLS_DIR}/formattington-lite"
FORMATTINGTON_LITE_VERSION_DIR="${FORMATTINGTON_LITE_DIR}/v0.0.3.0.67"
