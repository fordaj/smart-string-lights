# Platform env for macos-x86_64.
# Sourced by scripts/env.sh after .common.env. Paths are relative to
# the repository root; env.sh anchors them to absolute paths.

PROJECT_PLATFORM="macos-x86_64"

VERSIONER_BIN="${VERSIONER_VERSION_DIR}/${PROJECT_PLATFORM}/versioner"
LOGAMUFFIN_BIN="${LOGAMUFFIN_VERSION_DIR}/${PROJECT_PLATFORM}/logamuffin"
RUNNER_SPAWNER_BIN="${RUNNER_SPAWNER_VERSION_DIR}/${PROJECT_PLATFORM}/runner-spawner"
BARNACLE_BIN="${BARNACLE_VERSION_DIR}/${PROJECT_PLATFORM}/barnacle"
FORMATTINGTON_LITE_BIN="${FORMATTINGTON_LITE_VERSION_DIR}/${PROJECT_PLATFORM}/formattington"

# python venv (created with `uv sync`)
VENV_ACTIVATE="${VENV}/bin/activate"
PYTHON_EXE="${VENV}/bin/python"
PIO_EXE="${VENV}/bin/pio"
ESPTOOL_EXE="${VENV}/bin/esptool"

