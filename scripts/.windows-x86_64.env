# Platform env for windows-x86_64.
# Sourced by scripts/env.sh after .common.env. Paths are relative to
# the repository root; env.sh anchors them to absolute paths.

PROJECT_PLATFORM="windows-x86_64"

VERSIONER_BIN="${VERSIONER_VERSION_DIR}/${PROJECT_PLATFORM}/versioner.exe"
LOGAMUFFIN_BIN="${LOGAMUFFIN_VERSION_DIR}/${PROJECT_PLATFORM}/logamuffin.exe"
RUNNER_SPAWNER_BIN="${RUNNER_SPAWNER_VERSION_DIR}/${PROJECT_PLATFORM}/runner-spawner.exe"
BARNACLE_BIN="${BARNACLE_VERSION_DIR}/${PROJECT_PLATFORM}/barnacle.exe"
FORMATTINGTON_LITE_BIN="${FORMATTINGTON_LITE_VERSION_DIR}/${PROJECT_PLATFORM}/formattington.exe"

# python venv (created with `uv sync`)
VENV_ACTIVATE="${VENV}/Scripts/activate"
PYTHON_EXE="${VENV}/Scripts/python.exe"
PIO_EXE="${VENV}/Scripts/pio.exe"
ESPTOOL_EXE="${VENV}/Scripts/esptool.exe"

